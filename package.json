{
  "name": "ListextEditor",
  "productName": "\u4ebf\u65b9\u542c\u529b\u5927\u5e08",
  "version": "1.1.10",
  "description": "\u4ebf\u65b9\u542c\u529b\u5927\u5e08\u662f\u7531\u4ebf\u65b9\u8fd0\u7ef4\u5f00\u53d1\u7ec4\u5f00\u53d1\u7684\u8de8\u5e73\u53f0\u542c\u529b\u6750\u6599\u7f16\u8f91\u4e0e\u5408\u6210\u5de5\u5177\uff0c\u53ef\u4ee5\u7528\u642d\u79ef\u6728\u7684\u65b9\u5f0f\u521b\u4f5c\u542c\u529b\u6750\u6599\uff0c\u5177\u6709\u4e00\u8d77\u4f5c\u4e1a\u542c\u529b\u6750\u6599\u5236\u4f5c\u5de5\u5177\u7684100%\u529f\u80fd\uff0c\u5e76\u4e14\u66f4\u73b0\u4ee3\u5316\u3001\u53ef\u89c6\u5316\u3001\u667a\u80fd\u5316\u3001\u81ea\u4e3b\u53ef\u63a7\u3002 \u91c7\u7528\u5fae\u8f6f\u9ad8\u7cbe\u5ea6\u4eff\u771f\u8bed\u97f3\u5f15\u64ce\uff0c\u53d1\u97f3\u51c6\u786e\u81ea\u7136\u65e0\u673a\u68b0\u611f\uff0c\u652f\u6301\u5c0f\u8bed\u79cd\u542c\u529b\u5236\u4f5c\uff0c\u6ee1\u8db3\u65b0\u9ad8\u8003\u9700\u6c42\u3002\u652f\u6301Win/Mac/Linux\uff08\u4fe1\u521b\uff09\u4e09\u7aef\u7cfb\u7edf\u3002\u5168\u9762\u5f00\u6e90\u514d\u8d39\u3002",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never",
    "build:win:x64": "electron-builder --win nsis --x64 --publish never",
    "build:linux:x64": "electron-builder --linux AppImage deb --x64 --publish never",
    "build:linux:arm64": "electron-builder --linux AppImage deb --arm64 --publish never",
    "build:xinchuang": "npm run build:linux:x64 && npm run build:linux:arm64",
    "build:mac": "electron-builder --mac --publish never",
    "build:mac:arm64": "electron-builder --mac dmg --arm64 --publish never",
    "build:all": "npm run build:win:x64 && npm run build:xinchuang && npm run build:mac",
    "license:headers": "node scripts/add-license-header.js"
  },
  "keywords": [
    "electron",
    "tts",
    "EdgeTTS",
    "Blockly",
    "AI",
    "listening",
    "education"
  ],
  "author": "The InspireWorks Development Team",
  "homepage": "https://www.yfyw.top/",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@electron/asar": "^4.2.0",
    "axios": {
      "axios": "1.18.0"
    },
    "msedge-tts": {
      "axios": "1.18.0"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "ffmpeg-static": "^5.3.0",
    "fs-native-extensions": "^1.5.0",
    "material-icons": "^1.13.14",
    "msedge-tts": "^2.0.7",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "top.yfyw.listext-editor",
    "productName": "\u4ebf\u65b9\u542c\u529b\u5927\u5e08",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "pages/index.html",
      "pages/settings.html",
      "src/**/*",
      "styles/**/*",
      "assets/default-sounds/**/*",
      "assets/pay-qrcode/**/*",
      "assets/freeWatermark.mp3",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "ListextEditor-${version}-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "\u4ebf\u65b9\u542c\u529b\u5927\u5e08",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "allowElevation": true
    },
    "linux": {
      "category": "Utility",
      "icon": "build/linux-icons",
      "maintainer": "The InspireWorks Development Team <https://github.com/XiaoYangTech/ListextEditor>",
      "artifactName": "ListextEditor-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "artifactName": "ListextEditor-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}